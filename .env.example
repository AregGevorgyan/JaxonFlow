# JaxonFlow Environment Configuration
# Copy this file to .env and fill in the values for your chosen provider(s).

# =============================================================================
# LLM Provider API Keys (set the one(s) you use)
# =============================================================================

# Anthropic (Claude) — default provider
ANTHROPIC_API_KEY=

# OpenAI (GPT-4)
OPENAI_API_KEY=

# Google Gemini (public API)
GEMINI_API_KEY=

# OpenRouter (multi-model proxy)
OPENROUTER_API_KEY=

# =============================================================================
# Google Vertex AI (enterprise GCP)
# No API key needed — uses Application Default Credentials.
# Run: gcloud auth application-default login
# =============================================================================

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# =============================================================================
# AWS Bedrock
# No API key needed if using IAM roles or ~/.aws/credentials.
# Set these for explicit credential configuration.
# =============================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# JaxonFlow Backend Settings
# =============================================================================

# Hardware target: "auto", "A100-80GB", "H100-SXM", "V100-32GB", "RTX4090"
JAXONFLOW_HARDWARE_TARGET=auto

# Max agent iterations per kernel generation
JAXONFLOW_MAX_ITERATIONS=10

# Target speedup vs reference implementation
JAXONFLOW_TARGET_SPEEDUP=1.0

# Enable fallback to XLA/Inductor on agent failure (true/false)
JAXONFLOW_FALLBACK=true

# Logging level: DEBUG, INFO, WARNING, ERROR
JAXONFLOW_LOG_LEVEL=INFO

# Kernel cache directory (defaults to ~/.jaxonflow/cache)
JAXONFLOW_CACHE_DIR=

# Cost budget in USD (leave empty for unlimited)
JAXONFLOW_COST_BUDGET=
